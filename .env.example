# --- required for live reviews ---
# console.getsolari.com — leave empty and the floor runs as a DRY RUN (UI only, nothing measured)
SOLARI_API_KEY=

# --- recommended for contest discovery + sandbox git ---
# public-repo read PAT (classic or fine-grained)
# unauthenticated works for a few calls; ~300-fork discovery needs this
# also handed to git inside the sandbox as an extraheader, never written to a remote URL
GITHUB_TOKEN=

# --- required on Railway / any public deploy ---
# gates POST /api/jobs so strangers can't burn Solari credits.
# with NODE_ENV=production and this empty, reviews are disabled (503) — fail closed
FORKLIFT_ACCESS_KEY=

# --- database ---
# Railway: set on the forklift service as ${{Postgres.DATABASE_URL}}
# local: omit → SQLite at ./data/forklift.sqlite
DATABASE_URL=

# --- optional ---
# label for bay 05 when Your repo is left blank — point it at your public cookbook fork
# bay 05 always packs this deployed tree; the URL is what the card links to
FORKLIFT_SELF_REPO=https://github.com/you/solari-cookbook
SOLARI_BASE_URL=https://api.getsolari.com
# set to 1 to force a dry run even with a Solari key
FORKLIFT_FIXTURE=
# how many Solari sandboxes run at once (floor still shows 5 doors). default 2.
# bays open at once, across every floor in this process. A recording browser shares the
# org's session cap with the sandbox it films, so leave this at 1 unless your plan is roomy
FORKLIFT_BAY_CONCURRENCY=1
# how long a bay waits on the cap before it fails (ms). A bay ahead of it takes ~4 min
FORKLIFT_SLOT_WAIT_MS=360000
# 1 = build a warm snapshot once and boot bays from it. off by default; see README gotchas
FORKLIFT_WARM_SNAPSHOT=
# job id of a finished live floor. the landing page links it so visitors without the access key see real cards
NEXT_PUBLIC_SHOWROOM_FLOOR=
